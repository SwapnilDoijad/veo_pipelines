profiles {

  local {
    process.executor = 'local'
  }

  slurm {

    process {
      executor = 'slurm'
      queue = 'standard'
    }

    process {
      withLabel: low {
        cpus = 1
        memory = '2 GB'
        time = '2h'
        queue = 'standard'
      }

      withLabel: high {
        cpus = 24
        memory = '50 GB'
        queue = 'standard'
      }
    }

  }

}